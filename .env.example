# Optional integrations — the MVP runs fully on generated demo data without these.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Public origin used for canonical URLs, robots.txt and sitemap.xml
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentinel Hub (NDVI tiles) — https://www.sentinel-hub.com/
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# Map tiles (defaults to the public OpenStreetMap tile server)
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
